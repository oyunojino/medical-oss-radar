# Optional. Without this, GitHub's unauthenticated rate limit is 60 requests/hour,
# which this dashboard can burn through quickly once you add more projects.
# Create a token with no scopes (public repo read is enough) at:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Used by `npm run nvd` to backfill severity for OSV entries that
# don't carry a normalized severity, via NIST NVD's official CVSS scores.
# Without this, NVD allows 5 requests/30s; with it, 50 requests/30s.
# Free, no scopes: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
